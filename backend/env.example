# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit the real .env file. Restart the server after changing it.

# --- Server ---------------------------------------------------------------
PORT=3000

# --- Database (PostgreSQL) ------------------------------------------------
# Used by the app at runtime
DATABASE_URL="postgresql://postgres:password@localhost:5432/demoshop"
# Used by the Prisma CLI for migrations. Same as DATABASE_URL unless you use
# a connection pooler (e.g. Supabase), in which case use the direct connection.
DIRECT_URL="postgresql://postgres:password@localhost:5432/demoshop"

# --- Auth -----------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime
JWT_EXPIRES_IN=90d
# Cookie lifetime in DAYS, a plain number (not "90d")
JWT_COOKIE_EXPIRES_IN=90

# --- URLs -----------------------------------------------------------------
# Frontend origin, no trailing slash. Used for CORS, password reset links and
# the redirect after Google sign-in.
FRONTEND_URL=http://localhost:5173
# Optional extra allowed CORS origin
CLIENT_URL=

# --- Google sign-in (optional) --------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (type: Web application)
CLIENT_ID=
CLIENT_SECRET=
# Callback on the BACKEND. Must match "Authorized redirect URIs" in Google
# Cloud Console exactly (scheme, port, no trailing slash).
REDIRECT_URI=http://localhost:3000/api/v1/users/oauth/callback

# --- Email for password resets --------------------------------------------
# Default setup uses Gmail. Use a Google "app password", not your normal one:
# https://myaccount.google.com/apppasswords
EMAIL=
EMAIL_PASSWORD=

# Alternative: Mailtrap sandbox (see the commented block in utils/email.js).
# If you switch to it, these are used instead:
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USERNAME=
